  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b16855126567ad74da25980401382049, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlobalClickHandler
  textComponent: {fileID: 211107021}
  lines:
  - You took the potions they told you would cure your disease.
  - You crafted the herbs together
  - to create the salve that you thought would be your salvation.
  - Unfortunately, that could've been the worst mistake...
  - As a result of your selfish actions,
  - the disease has spread all throughout your body,
  - 'leaving your corpse as a hotbed for '
  - what the people of the world call...
  - The Second Great Plague.
  - Millions are actively dying,
  - ' through your search for healing, you merely exasperated the issue.'
  - 'There will never be salvation for humanity. '
  - Only a new normal for the remaining survivors.
